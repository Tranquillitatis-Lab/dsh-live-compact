{
  "name": "dsh-live-compact",
  "version": "1.1.4",
  "description": "In-place newest-turn compaction for DeepSeek Harness. Compress while the task runs and keep the prefix.",
  "license": "MIT",
  "author": "MerkyorLynn <268568828+MerkyorLynn@users.noreply.github.com>",
  "type": "module",
  "main": "shell.js",
  "bin": {
    "dsh-live-compact": "bin/dsh-live-compact.js"
  },
  "exports": {
    ".": "./shell.js",
    "./client": "./client.js",
    "./engine": "./index.js",
    "./gate": "./gate.js",
    "./shadow-search": "./shadow-search.js"
  },
  "files": [
    "shell.js",
    "adapter.js",
    "settings.js",
    "client.js",
    "index.js",
    "gate.js",
    "plan.js",
    "raw.js",
    "shadow.js",
    "shadow-search.js",
    "cooldown.js",
    "thunder.js",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "compaction"
  ],
  "scripts": {
    "test:gate": "node test/p0-gate.mjs && node test/p0-blockers.mjs && node test/excerpt.mjs && node --test test/public-exports.test.mjs test/cooldown.test.mjs test/gate-config.test.mjs test/drain-stopline.mjs test/scan-once.mjs test/issue-19.mjs test/issue-20.mjs test/issue-34.mjs test/windows-acl.test.mjs test/issue-27.mjs test/issue-29.mjs test/issue-29-notice.mjs test/client-settings.test.mjs test/settings-integration.test.mjs test/runtime-lifecycle.mjs test/shadow-lifecycle.mjs test/finalize-over-32000.mjs",
    "test:live-gate": "python3 -B -m unittest discover -s test/live-fill -p test_*.py"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tranquillitatis-Lab/dsh-live-compact.git"
  },
  "homepage": "https://github.com/Tranquillitatis-Lab/dsh-live-compact#readme",
  "bugs": {
    "url": "https://github.com/Tranquillitatis-Lab/dsh-live-compact/issues"
  }
}
